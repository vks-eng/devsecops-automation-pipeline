# ---------------------------------------------------------------------------
# ShieldOps - example configuration. Copy to .env and adjust.
# NEVER commit a real .env file. All values below are non-secret placeholders.
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# PostgreSQL only (psycopg2 driver). docker-compose overrides the host to "postgres".
DATABASE_URL=postgresql+psycopg2://devsecops:devsecops@localhost:5432/devsecops
POSTGRES_USER=devsecops
POSTGRES_PASSWORD=devsecops
POSTGRES_DB=devsecops

# Auth - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOW_REGISTRATION=true
# Fernet key for encrypting integration tokens at rest. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty = derived from SECRET_KEY (development only).
TOKEN_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Background processing. true = run tasks in-process (no Redis needed).
CELERY_TASK_ALWAYS_EAGER=true
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Integrations - "mock" works with no credentials.
GITHUB_MODE=mock
GITHUB_API_URL=https://api.github.com
# Shared secret configured on the GitHub webhook (workflow_run events).
GITHUB_WEBHOOK_SECRET=
SONARQUBE_MODE=mock
SONARQUBE_URL=http://localhost:9000
SONARQUBE_TOKEN=
# mock | binary (local trivy) | docker (aquasec/trivy container)
TRIVY_MODE=mock
TRIVY_BINARY=trivy
TRIVY_DOCKER_IMAGE=aquasec/trivy:0.58.1
TRIVY_TIMEOUT_SECONDS=600
DOCKER_MODE=mock
DOCKER_BINARY=docker
PIP_AUDIT_MODE=mock
PIP_AUDIT_BINARY=pip-audit
PIP_AUDIT_TIMEOUT_SECONDS=300
HTTP_TIMEOUT_SECONDS=15

# Optional outbound notification channels (disabled when empty)
NOTIFICATION_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=devsecops@localhost
SMTP_USE_TLS=true

# Frontend (Vite) - API base URL used by the browser in local dev
VITE_API_BASE_URL=http://localhost:8000/api/v1
